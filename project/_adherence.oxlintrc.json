      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|children|icon|onDone|duration|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: open, children, icon, onDone, duration."
      }
