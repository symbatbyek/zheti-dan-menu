        "selector": "JSXOpeningElement[name.name='MenuRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|photo|available|onToggle|onClick|draggable|soldOutLabel|availableLabel|key|ref|className|style|children)$/]",
        "message": "<MenuRow> doesn't accept that prop. Declared props: name, price, photo, available, onToggle, onClick, draggable, soldOutLabel, availableLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoPlaceholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|iconSize|key|ref|className|style|children)$/]",
        "message": "<PhotoPlaceholder> doesn't accept that prop. Declared props: label, icon, iconSize."
      },
      {
        "selector": "JSXOpeningElement[name.name='Price'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|strike|className|style|key|ref|className|style|children)$/]",
        "message": "<Price> doesn't accept that prop. Declared props: value, size, strike, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QrCode'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|color|key|ref|className|style|children)$/]",
        "message": "<QrCode> doesn't accept that prop. Declared props: value, size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioList'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<RadioList> doesn't accept that prop. Declared props: options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|count|action|variant|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: children, count, action, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:caps|title)$/]",
        "message": "<SectionHeader> variant must be one of 'caps' | 'title'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segmented'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|inline|key|ref|className|style|children)$/]",
        "message": "<Segmented> doesn't accept that prop. Declared props: options, value, onChange, inline."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|value|onChange|options|placeholder|title|variant|id|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, hint, value, onChange, options, placeholder, title, variant, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:field|inline)$/]",
        "message": "<Select> variant must be one of 'field' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|subtitle|control|onClick|chevron|key|ref|className|style|children)$/]",
        "message": "<SettingRow> doesn't accept that prop. Declared props: icon, title, subtitle, control, onClick, chevron."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|radius|style|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|label|hours|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: open, label, hours."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|ariaLabel|disabled|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, ariaLabel, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|icon|children|pressed|onClick|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: kind, icon, children, pressed, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:spicy|veg|new|popular|neutral|soldout)$/]",
        "message": "<Tag> kind must be one of 'spicy' | 'veg' | 'new' | 'popular' | 'neutral' | 'soldout'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|prefix|suffix|icon|multiline|rows|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, error, prefix, suffix, icon, multiline, rows."
