{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/admin/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/menu/**",
              "components/navigation/**",
              "ui_kits/admin/**",
              "ui_kits/guest-menu/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Onest|Noto Sans SC))/i]",
        "message": "Font not provided by the design system. Available: Onest, Noto Sans SC."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|backLabel|actions|center|style|key|ref|className|style|children)$/]",
        "message": "<AppBar> doesn't accept that prop. Declared props: title, onBack, backLabel, actions, center, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|action|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: tone, icon, children, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|accent|closed|danger|success|warning)$/]",
        "message": "<Banner> tone must be one of 'info' | 'accent' | 'closed' | 'danger' | 'success' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|key|ref|className|style|children)$/]",
        "message": "<BottomNav> doesn't accept that prop. Declared props: items, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|children|showClose|closeLabel|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: open, onClose, children, showClose, closeLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|icon|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, icon, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|soft|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'soft' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CafeHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|logo|cover|open|statusLabel|hours|onInfo|trailing|key|ref|className|style|children)$/]",
        "message": "<CafeHeader> doesn't accept that prop. Declared props: name, logo, cover, open, statusLabel, hours, onInfo, trailing."
      },
      {
        "selector": "JSXOpeningElement[name.name='CafeLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|key|ref|className|style|children)$/]",
        "message": "<CafeLogo> doesn't accept that prop. Declared props: src, name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|sticky|key|ref|className|style|children)$/]",
        "message": "<CategoryTabs> doesn't accept that prop. Declared props: items, value, onChange, sticky."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:length|value|onChange|autoFocus|key|ref|className|style|children)$/]",
        "message": "<CodeInput> doesn't accept that prop. Declared props: length, value, onChange, autoFocus."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|options|key|ref|className|style|children)$/]",
        "message": "<ColorPicker> doesn't accept that prop. Declared props: value, onChange, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|actions|onClose|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, children, actions, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|action|dashed|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, children, action, dashed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fab'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|key|ref|className|style|children)$/]",
        "message": "<Fab> doesn't accept that prop. Declared props: icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='HoursTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:days|today|key|ref|className|style|children)$/]",
        "message": "<HoursTable> doesn't accept that prop. Declared props: days, today."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|label|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, label, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|secondary|overlay|danger)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'secondary' | 'overlay' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|price|photo|placeholder|tags|soldOut|soldOutLabel|layout|onClick|lang|key|ref|className|style|children)$/]",
        "message": "<ItemCard> doesn't accept that prop. Declared props: name, description, price, photo, placeholder, tags, soldOut, soldOutLabel, layout, onClick, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:row|feature)$/]",
        "message": "<ItemCard> layout must be one of 'row' | 'feature'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangSwitcher'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|languages|key|ref|className|style|children)$/]",
        "message": "<LangSwitcher> doesn't accept that prop. Declared props: value, onChange, languages."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangSwitcher'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:kz|ru|en|zh)$/]",
        "message": "<LangSwitcher> value must be one of 'kz' | 'ru' | 'en' | 'zh'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|status|languages|key|ref|className|style|children)$/]",
        "message": "<LangTabs> doesn't accept that prop. Declared props: value, onChange, status, languages."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|inset|key|ref|className|style|children)$/]",
        "message": "<ListGroup> doesn't accept that prop. Declared props: children, inset."
      },
